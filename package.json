{
  "name": "bunrift",
  "version": "0.1.0",
  "description": "A modern, production-ready starter template with Next.js 16 Canary, Better Auth, PostgreSQL via Drizzle ORM, and Biome for linting and formatting.",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check",
    "format": "biome format --write",
    "drizzle:generate": "bunx --bun drizzle-kit generate --config src/lib/db/drizzle.config.ts",
    "drizzle:push": "bunx --bun drizzle-kit push --config src/lib/db/drizzle.config.ts"
  },
  "dependencies": {
    "better-auth": "^1.4.6",
    "drizzle-orm": "^0.45.1",
    "next": "16.1.0-canary.16",
    "postgres": "^3.4.7",
    "react": "19.2.1",
    "react-dom": "19.2.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.0",
    "@tailwindcss/postcss": "^4",
    "@types/bun": "^1.3.4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.8",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
